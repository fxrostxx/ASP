<h6>Learning days:</h6>
<ul class="weekdays form-control">
	@for (int i = 0; i < 7; ++i)
	{
		<li>
			<input type="checkbox" id="@Week.DAY_NAMES[i]" @bind="@days[i]" />
			<label for="@Week.DAY_NAMES[i]">@Week.DAY_NAMES[i]</label>
		</li>
	}
</ul>

@code {
	bool[] days = new bool[7];
	[Parameter] public Models.Group Group { get; set; }
}
