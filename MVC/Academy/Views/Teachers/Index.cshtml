@model TeacherIndexData
@{
	ViewData["Title"] = "Преподаватели";
}
<h1>Преподаватели</h1>
<p><a asp-action="Create" class="btn btn-success">Добавить преподавателя</a></p>
<form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 mb-3">
	<input type="hidden" name="id" value="@ViewData["SelectedId"]" />
	<input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
	<input class="form-control search-input" type="search" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Поиск" aria-label="Поиск" />
	<button type="submit" class="btn btn-primary">Найти</button>
	<a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
</form>
<div class="table-responsive">
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Фото</th>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]">ФИО</a></th>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]">Возраст</a></th>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["ExperienceSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]">Стаж</a></th>
				<th>Ставка</th>
				<th>Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Teacher item in Model.Teachers)
			{
				<tr class="@(Model.SelectedTeacher?.teacher_id == item.teacher_id ? "selected-row" : "")" data-record="@item.teacher_id">
					<td><partial name="_Photo" model="item" /></td>
					<td>@item.FullName</td>
					<td>@item.Age</td>
					<td>@item.Experience</td>
					<td>@item.rate.ToString("0.00")</td>
					<td><a asp-action="Index" asp-route-id="@item.teacher_id" asp-route-pageNumber="@Model.Teachers.PageIndex" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Дисциплины</a> | <a asp-action="Details" asp-route-id="@item.teacher_id">Подробнее</a> | <a asp-action="Edit" asp-route-id="@item.teacher_id">Изменить</a> | <a asp-action="Delete" asp-route-id="@item.teacher_id">Удалить</a></td>
				</tr>
			}
			@if (Model.Teachers.Count == 0)
			{
				<tr><td colspan="6">Записи не найдены.</td></tr>
			}
		</tbody>
	</table>
</div>
@{
	string prevDisabled = Model.Teachers.HasPreviousPage ? "" : "disabled";
	string nextDisabled = Model.Teachers.HasNextPage ? "" : "disabled";
}
<div class="pagination-controls d-flex flex-wrap gap-2 align-items-center">
	<a asp-action="Index" asp-route-pageNumber="@(Model.Teachers.PageIndex - 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn btn-outline-primary @prevDisabled">Назад</a>
	@for (int i = 1; i <= Model.Teachers.TotalPages; i++)
	{
		string currentPage = i == Model.Teachers.PageIndex ? "btn-primary" : "btn-outline-primary";
		<a asp-action="Index" asp-route-pageNumber="@i" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn @currentPage">@i</a>
	}
	<a asp-action="Index" asp-route-pageNumber="@(Model.Teachers.PageIndex + 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn btn-outline-primary @nextDisabled">Вперед</a>
</div>
@if (Model.SelectedTeacher != null)
{
	<section class="related-list">
		<h2>Дисциплины: @Model.SelectedTeacher.FullName</h2>
		<table class="table table-striped">
			<thead><tr><th>Дисциплина</th><th>Количество занятий</th><th></th></tr></thead>
			<tbody>
				@foreach (Discipline discipline in (Model.SelectedTeacher.DisciplinesRelations.Select(r => r.Discipline)).OrderBy(d => d.discipline_name))
				{
					<tr><td>@discipline.discipline_name</td><td>@discipline.number_of_lessons</td><td><a asp-controller="Disciplines" asp-action="Details" asp-route-id="@discipline.discipline_id">Подробнее</a></td></tr>
				}
				@if (!(Model.SelectedTeacher.DisciplinesRelations.Select(r => r.Discipline)).Any())
				{
					<tr><td colspan="3" class="text-muted">Дисциплин нет.</td></tr>
				}
			</tbody>
		</table>
	</section>
}
