@model DisciplineIndexData
@{
	ViewData["Title"] = "Дисциплины";
}
<h1>Дисциплины</h1>
<p><a asp-action="Create" class="btn btn-success">Добавить дисциплину</a></p>
<form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 mb-3">
	<input type="hidden" name="id" value="@ViewData["SelectedId"]" />
	<input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
	<input class="form-control search-input" type="search" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Поиск" aria-label="Поиск" />
	<button type="submit" class="btn btn-primary">Найти</button>
	<a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
</form>
<div class="table-responsive">
	<table class="table table-striped">
		<thead>
			<tr>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]">Дисциплина</a></th>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["LessonsSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]">Количество занятий</a></th>
				<th>Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Discipline item in Model.Disciplines)
			{
				<tr class="@(Model.SelectedDiscipline?.discipline_id == item.discipline_id ? "selected-row" : "")" data-record="@item.discipline_id">
					<td>@item.discipline_name</td>
					<td>@item.number_of_lessons</td>
					<td><a asp-action="Index" asp-route-id="@item.discipline_id" asp-route-pageNumber="@Model.Disciplines.PageIndex" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Преподаватели</a> | <a asp-action="Details" asp-route-id="@item.discipline_id">Подробнее</a> | <a asp-action="Edit" asp-route-id="@item.discipline_id">Изменить</a> | <a asp-action="Delete" asp-route-id="@item.discipline_id">Удалить</a></td>
				</tr>
			}
			@if (Model.Disciplines.Count == 0)
			{
				<tr><td colspan="3">Записи не найдены.</td></tr>
			}
		</tbody>
	</table>
</div>
@{
	string prevDisabled = Model.Disciplines.HasPreviousPage ? "" : "disabled";
	string nextDisabled = Model.Disciplines.HasNextPage ? "" : "disabled";
}
<div class="pagination-controls d-flex flex-wrap gap-2 align-items-center">
	<a asp-action="Index" asp-route-pageNumber="@(Model.Disciplines.PageIndex - 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn btn-outline-primary @prevDisabled">Назад</a>
	@for (int i = 1; i <= Model.Disciplines.TotalPages; i++)
	{
		string currentPage = i == Model.Disciplines.PageIndex ? "btn-primary" : "btn-outline-primary";
		<a asp-action="Index" asp-route-pageNumber="@i" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn @currentPage">@i</a>
	}
	<a asp-action="Index" asp-route-pageNumber="@(Model.Disciplines.PageIndex + 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn btn-outline-primary @nextDisabled">Вперед</a>
</div>
@if (Model.SelectedDiscipline != null)
{
	<section class="related-list">
		<h2>Преподаватели: @Model.SelectedDiscipline.discipline_name</h2>
		<table class="table table-striped">
			<thead><tr><th>Преподаватель</th><th>Стаж</th><th></th></tr></thead>
			<tbody>
				@foreach (Teacher teacher in (Model.SelectedDiscipline.TeachersRelations.Select(r => r.Teacher)).OrderBy(t => t.last_name).ThenBy(t => t.first_name))
				{
					<tr><td>@teacher.FullName</td><td>@teacher.Experience</td><td><a asp-controller="Teachers" asp-action="Details" asp-route-id="@teacher.teacher_id">Подробнее</a></td></tr>
				}
				@if (!(Model.SelectedDiscipline.TeachersRelations.Select(r => r.Teacher)).Any())
				{
					<tr><td colspan="3" class="text-muted">Преподавателей нет.</td></tr>
				}
			</tbody>
		</table>
	</section>
}
