@model Discipline
@{
	ViewData["Title"] = "Удаление дисциплины";
}
<h1>Удаление дисциплины</h1>
<p>Удалить эту запись?</p>
<div asp-validation-summary="All" class="text-danger"></div>
<dl class="row">
	<dt class="col-sm-3">Дисциплина</dt>
	<dd class="col-sm-9">@Model.discipline_name</dd>
	<dt class="col-sm-3">Количество занятий</dt>
	<dd class="col-sm-9">@Model.number_of_lessons</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.discipline_id" method="post">
	<button type="submit" class="btn btn-danger">Удалить</button>
	<a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
</form>
