@model GroupIndexData
@{
	ViewData["Title"] = "Группы";
}
<h1>Группы</h1>
<p><a asp-action="Create" class="btn btn-success">Добавить группу</a></p>
<form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 mb-3">
	<input type="hidden" name="id" value="@ViewData["SelectedId"]" />
	<select name="directionId" asp-items="ViewBag.Directions" class="form-select filter-select" aria-label="Направление"><option value="">Все направления</option></select>
	<input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
	<input class="form-control search-input" type="search" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Поиск" aria-label="Поиск" />
	<button type="submit" class="btn btn-primary">Найти</button>
	<a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
</form>
<div class="table-responsive">
	<table class="table table-striped">
		<thead>
			<tr>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-directionId="@ViewData["DirectionId"]" asp-route-id="@ViewData["SelectedId"]">Группа</a></th>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["DirectionSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-directionId="@ViewData["DirectionId"]" asp-route-id="@ViewData["SelectedId"]">Направление</a></th>
				<th>Дни занятий</th>
				<th>Время</th>
				<th><a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-directionId="@ViewData["DirectionId"]" asp-route-id="@ViewData["SelectedId"]">Дата начала</a></th>
				<th>Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Group item in Model.Groups)
			{
				<tr class="@(Model.SelectedGroup?.group_id == item.group_id ? "selected-row" : "")" data-record="@item.group_id">
					<td>@item.group_name.Trim()</td>
					<td>@item.Direction.direction_name</td>
					<td>@item.LearningDaysText</td>
					<td>@item.start_time?.ToString("HH:mm")</td>
					<td>@item.start_date?.ToString("dd.MM.yyyy")</td>
					<td><a asp-action="Index" asp-route-id="@item.group_id" asp-route-pageNumber="@Model.Groups.PageIndex" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-directionId="@ViewData["DirectionId"]">Студенты</a> | <a asp-action="Details" asp-route-id="@item.group_id">Подробнее</a> | <a asp-action="Edit" asp-route-id="@item.group_id">Изменить</a> | <a asp-action="Delete" asp-route-id="@item.group_id">Удалить</a></td>
				</tr>
			}
			@if (Model.Groups.Count == 0)
			{
				<tr><td colspan="6">Записи не найдены.</td></tr>
			}
		</tbody>
	</table>
</div>
@{
	string prevDisabled = Model.Groups.HasPreviousPage ? "" : "disabled";
	string nextDisabled = Model.Groups.HasNextPage ? "" : "disabled";
}
<div class="pagination-controls d-flex flex-wrap gap-2 align-items-center">
	<a asp-action="Index" asp-route-pageNumber="@(Model.Groups.PageIndex - 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" asp-route-directionId="@ViewData["DirectionId"]" class="btn btn-outline-primary @prevDisabled">Назад</a>
	@for (int i = 1; i <= Model.Groups.TotalPages; i++)
	{
		string currentPage = i == Model.Groups.PageIndex ? "btn-primary" : "btn-outline-primary";
		<a asp-action="Index" asp-route-pageNumber="@i" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" asp-route-directionId="@ViewData["DirectionId"]" class="btn @currentPage">@i</a>
	}
	<a asp-action="Index" asp-route-pageNumber="@(Model.Groups.PageIndex + 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" asp-route-directionId="@ViewData["DirectionId"]" class="btn btn-outline-primary @nextDisabled">Вперед</a>
</div>
@if (Model.SelectedGroup != null)
{
	<section class="related-list">
		<h2>Студенты группы @Model.SelectedGroup.group_name.Trim()</h2>
		<table class="table table-striped">
			<thead><tr><th>Студент</th><th>Возраст</th><th></th></tr></thead>
			<tbody>
				@foreach (Student student in (Model.SelectedGroup.Students))
				{
					<tr><td>@student.FullName</td><td>@student.Age</td><td><a asp-controller="Students" asp-action="Details" asp-route-id="@student.stud_id">Подробнее</a></td></tr>
				}
				@if (!(Model.SelectedGroup.Students).Any())
				{
					<tr><td colspan="3" class="text-muted">Студентов нет.</td></tr>
				}
			</tbody>
		</table>
	</section>
}
