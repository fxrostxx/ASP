@model DirectionIndexData
@{
	ViewData["Title"] = "Направления";
}
<h1>Направления</h1>
<p><a asp-action="Create" class="btn btn-success">Добавить направление</a></p>
<form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 mb-3">
	<input type="hidden" name="id" value="@ViewData["SelectedId"]" />
	<input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
	<input class="form-control search-input" type="search" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Поиск" aria-label="Поиск" />
	<button type="submit" class="btn btn-primary">Найти</button>
	<a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
</form>
<div class="table-responsive">
	<table class="table table-striped">
		<thead><tr><th><a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]">Направление</a></th><th>Действия</th></tr></thead>
		<tbody>
			@foreach (Direction item in Model.Directions)
			{
				<tr class="@(Model.SelectedDirection?.direction_id == item.direction_id ? "selected-row" : "")" data-record="@item.direction_id">
					<td>@item.direction_name</td>
					<td><a asp-action="Index" asp-route-id="@item.direction_id" asp-route-pageNumber="@Model.Directions.PageIndex" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">Группы</a> | <a asp-action="Details" asp-route-id="@item.direction_id">Подробнее</a> | <a asp-action="Edit" asp-route-id="@item.direction_id">Изменить</a> | <a asp-action="Delete" asp-route-id="@item.direction_id">Удалить</a></td>
				</tr>
			}
			@if (Model.Directions.Count == 0)
			{
				<tr><td colspan="2">Записи не найдены.</td></tr>
			}
		</tbody>
	</table>
</div>
@{
	string prevDisabled = Model.Directions.HasPreviousPage ? "" : "disabled";
	string nextDisabled = Model.Directions.HasNextPage ? "" : "disabled";
}
<div class="pagination-controls d-flex flex-wrap gap-2 align-items-center">
	<a asp-action="Index" asp-route-pageNumber="@(Model.Directions.PageIndex - 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn btn-outline-primary @prevDisabled">Назад</a>
	@for (int i = 1; i <= Model.Directions.TotalPages; i++)
	{
		string currentPage = i == Model.Directions.PageIndex ? "btn-primary" : "btn-outline-primary";
		<a asp-action="Index" asp-route-pageNumber="@i" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn @currentPage">@i</a>
	}
	<a asp-action="Index" asp-route-pageNumber="@(Model.Directions.PageIndex + 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-currentFilter="@ViewData["CurrentFilter"]" asp-route-id="@ViewData["SelectedId"]" class="btn btn-outline-primary @nextDisabled">Вперед</a>
</div>
@if (Model.SelectedDirection != null)
{
	<section class="related-list">
		<h2>Группы: @Model.SelectedDirection.direction_name</h2>
		<table class="table table-striped">
			<thead><tr><th>Группа</th><th>Дни занятий</th><th>Дата начала</th><th></th></tr></thead>
			<tbody>
				@foreach (Group group in (Model.SelectedDirection.Groups))
				{
					<tr><td>@group.group_name.Trim()</td><td>@group.LearningDaysText</td><td>@group.start_date?.ToString("dd.MM.yyyy")</td><td><a asp-controller="Groups" asp-action="Details" asp-route-id="@group.group_id">Подробнее</a> | <a asp-controller="Students" asp-action="Index" asp-route-groupId="@group.group_id">Студенты</a></td></tr>
				}
				@if (!(Model.SelectedDirection.Groups).Any())
				{
					<tr><td colspan="4" class="text-muted">Групп нет.</td></tr>
				}
			</tbody>
		</table>
	</section>
}
