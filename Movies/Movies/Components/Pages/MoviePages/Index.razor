@page "/movies"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Movies.Models
@implements IAsyncDisposable
@inject IDbContextFactory<MoviesContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Movies</PageTitle>

<h1>Movies</h1>

<p>
	<a href="movies/create">Create New</a>
</p>

<div class="controls">
	<form action="/movies">
		<input type="search" name="titleFilter" />
		<input type="submit" value="Search" class="btn btn-primary" />
	</form>
	<div>
		<label for="items-per-page">Items per page:</label>
		<select id="items-per-page" @bind="pagination.ItemsPerPage">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="10">10</option>
		</select>
	</div>
</div>

<div>
	<QuickGrid Class="table" Items="filteredMovies" Pagination="pagination">
		<PropertyColumn Property="movie => movie.Title" Class="movie-title" Sortable="true" />
		<PropertyColumn Property="movie => movie.ReleaseDate" Class="release-date" Sortable="true" />
		<PropertyColumn Property="movie => movie.Genre" Class="genre" Sortable="true" />

		<TemplateColumn Context="movie">
			<a href="@($"movies/details?id={movie.Id}")">Details</a>
		</TemplateColumn>
	</QuickGrid>
	<Paginator State="pagination" />
</div>

@code {
	private MoviesContext context = default!;
	[SupplyParameterFromQuery]
	string? titleFilter { get; set; }
	IQueryable<Movie> filteredMovies => context.Movie.Where(m => m.Title.Contains(titleFilter ?? string.Empty));
	PaginationState pagination = new PaginationState { ItemsPerPage = 3 };

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
