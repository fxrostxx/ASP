@page "/power"
@rendermode InteractiveServer

<PageTitle>Power</PageTitle>
<h3>Power</h3>

<div>
	<label>Base: </label>
	<input type="number" @bind="baseNum" @bind:after="Calculate" />
	<label>Power: </label>
	<input type="number" @bind="powerNum" @bind:after="Calculate" />
</div>
<div>
	<h3>= @result</h3>
</div>
<button class="btn btn-primary" @onclick="Calculate">Calculate</button>