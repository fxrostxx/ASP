@page "/power"
@rendermode InteractiveServer

<h3>Power</h3>

<div>
	<label>Base: </label>
	<input type="number" @bind="baseNum" @bind:after="Calculate" />
	<label>Power: </label>
	<input type="number" @bind="powerNum" @bind:after="Calculate" />
</div>
<div>
	<h3>= @result</h3>
</div>
<button class="btn btn-primary" @onclick="Calculate">Calculate</button>


@code {
	int baseNum = 0;
	int powerNum = 0;
	double result = 0;
	void Calculate()
	{
		result = 1;
		if (powerNum == 0) result = 1;
		for (int i = 0; i < Math.Abs(powerNum); ++i) result *= baseNum;
		if (powerNum < 0) result = 1 / result;
	}
}
