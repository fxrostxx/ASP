@page "/factorial"
@rendermode InteractiveServer

<h3>Factorial</h3>

<input type="number" @bind="num" /> ! = <h3>=@factorial</h3>
<button @onclick="Calculate">Calculate</button>

@code {
	int num = 0;
	int factorial = 1;
	void Calculate()
	{
		factorial = 1;
		for (int i = 1; i <= num; ++i) factorial *= i;
	}
}
